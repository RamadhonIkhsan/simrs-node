PORT=3001
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=simrs
DB_USER=postgres
DB_PASSWORD=admin
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# Shared JWT Config (harus identik dengan Yii2)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Komunikasi internal ke Yii2
YII_BASE_URL=http://127.0.0.1:8080
INTERNAL_SERVICE_KEY=your_internal_service_key_here
